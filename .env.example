# Optional refresh token for authenticated OpenAIRE API access (not required for the MVP demo).
# Keep this secret server-side. It expires after one month and is exchanged for a short-lived access token.
# OPENAIRE_REFRESH_TOKEN=

# OpenAIRE Graph API base URL.
OPENAIRE_BASE_URL=https://api.openaire.eu

# Finite per-request timeout in milliseconds.
# OPENAIRE_TIMEOUT_MS=15000
